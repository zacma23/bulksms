# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# SMS_IO_API_KEY: Required server-side API key for SMS.io / SMS.to gateway.
# Configure this in Vercel Environment Variables or AI Studio Secrets.
# NEVER expose this key to frontend code.
SMS_IO_API_KEY=""

# SMS_IO_SENDER_ID: Approved alphanumeric sender ID (max 11 chars, e.g. ZACMA).
SMS_IO_SENDER_ID="ZACMA"

# SMS_IO_API_BASE_URL: Official SMS.io / SMS.to REST API base URL (optional override).
SMS_IO_API_BASE_URL="https://api.sms.to"

# SMS_IO_AUTH_BASE_URL: Official SMS.io / SMS.to Auth/Balance API base URL (optional override).
SMS_IO_AUTH_BASE_URL="https://auth.sms.to"

# SMS_IO_WEBHOOK_SECRET: Optional shared secret for verifying incoming delivery report webhooks.
SMS_IO_WEBHOOK_SECRET=""
