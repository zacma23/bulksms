# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Optional Firebase client auth domain override (defaults to firebase-applet-config.json authDomain: zacma-4881c.firebaseapp.com).
# Only override if you configured a custom Firebase Auth handler domain.
VITE_FIREBASE_AUTH_DOMAIN=""

# Optional comma-separated list of production/preview domains for runtime diagnostics (e.g. your-app.vercel.app,sms.zacmatech.com).
# Remember: Domains MUST also be added in Firebase Console -> Authentication -> Settings -> Authorized domains.
VITE_FIREBASE_AUTHORIZED_DOMAINS=""
